#cloud-config
# Borsagator worker-2 provisioning template (issue #33).
# Rendered at launch time by scripts/render_worker_cloudinit.py, which
# substitutes __GATOR_BUS_URL__ (an HTTPS git URL carrying a
# borsagator-only credential) and __GATOR_ENV_EXTRA__ (tool API keys,
# one KEY=value per line, may be empty). The RENDERED file contains
# secrets and must never be committed — only this template lives in
# the repo.
packages:
  - git
  - python3-venv
  - python3-pip
  - jq
  # Chromium runtime libraries for the EGX harvester (issue #47) —
  # playwright's browser needs these system libs; the gator user has
  # no sudo to install them later.
  - libnss3
  - libatk1.0-0t64
  - libatk-bridge2.0-0t64
  - libcups2t64
  - libdrm2
  - libxkbcommon0
  - libxcomposite1
  - libxdamage1
  - libxfixes3
  - libxrandr2
  - libgbm1
  - libasound2t64
  - libpango-1.0-0
  - libcairo2
  # Virtual display so the harvester can run a HEADFUL Chromium —
  # the TSPD wall never resolves for the headless shell (proven:
  # 90 s wait, body stayed empty).
  - xvfb
users:
  - name: gator
    system: true
    shell: /usr/sbin/nologin
    homedir: /opt/gator
write_files:
  - path: /etc/gator.env
    permissions: "0600"
    content: |
      GATOR_ROOT=/opt/gator
      GATOR_POLL=300
      GATOR_BUS_URL=__GATOR_BUS_URL__
      __GATOR_ENV_EXTRA__
runcmd:
  - mkdir -p /opt/gator
  - git clone --depth 1 https://github.com/moos-labs/borsagator /opt/gator/src
  - cp /opt/gator/src/worker/worker.py /opt/gator/worker.py
  - cp /opt/gator/src/worker/borsagator-worker.service /etc/systemd/system/
  - chown -R gator:gator /opt/gator
  - systemctl daemon-reload
  - systemctl enable --now borsagator-worker
